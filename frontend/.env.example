# LEASIR — Frontend public configuration (Sepolia testnet)
# NEXT_PUBLIC_* variables are embedded in the client bundle and are PUBLIC.
# NEVER put private keys, API tokens, or secrets here.

# Deployed RentalAgreement contract address on Sepolia (required)
NEXT_PUBLIC_CONTRACT_ADDRESS=

# Expected chain id (11155111 = Sepolia, 31337 = local Hardhat dev)
NEXT_PUBLIC_CHAIN_ID=11155111

# Public read-only RPC used for reads when no wallet is connected
NEXT_PUBLIC_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com