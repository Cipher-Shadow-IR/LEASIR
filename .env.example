# LEASIR - environment template
# PUBLIC / LOCAL DEFAULTS ONLY + deployment secrets placeholders.
# NEVER commit real private keys, API tokens, or credentials here.

# --- Local Hardhat / Docker development defaults (used by docker-compose & frontend dev) ---
RPC_URL=http://localhost:8545

# --- Sepolia deployment secrets (used by contracts/hardhat.config.js) ---
# Copy this file to ".env" and fill in values. Never commit the real .env.
SEPOLIA_RPC_URL=

# Dedicated Sepolia deployer wallet private key - TESTNET ONLY.
PRIVATE_KEY=